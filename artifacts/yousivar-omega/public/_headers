# Cloudflare Pages static asset and APK handling
# This is the minimum set needed to preserve the Android download behavior.

/*
  Cloudflare Pages automatically serves static files from the project. The APK
  download is a static asset under /downloads/*.apk, so it must be served with the
  correct Content-Type header or some browsers/referrers will reject it.
*/

/*.apk
  Content-Type: application/vnd.android.package-archive
  Cache-Control: public, max-age=3600

/*
  Default security headers remain the app’s own origin and avoid cross-site API
  access from other origins. More specific responses can be tuned in the Cloudflare
  dashboard if needed.
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https://*.clerk.accounts.dev https://*.cloudflare.com;
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
