{
  // Cloudflare Pages project for the YOUSIVAR–Ω web client.
  //
  // Deploy from this directory (the Pages "project root"):
  //   pnpm --filter @workspace/yousivar-omega run build
  //   pnpm dlx wrangler pages deploy
  //
  // VITE_CLERK_PUBLISHABLE_KEY is baked into the bundle at BUILD time, so it
  // must be present in the environment that runs the build (see
  // CLOUDFLARE.md). It is a publishable key, not a secret; the secret keys stay
  // on the API Worker.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yousivar-omega",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  // `vite build` writes the deployable static site here (see vite.config.ts).
  "pages_build_output_dir": "./dist/public"
}
