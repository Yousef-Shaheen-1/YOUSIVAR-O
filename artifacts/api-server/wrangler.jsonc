{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yousivar-omega-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "4343fdf0a63f4a788c647b28998f2b84"
    }
  ],
  "vars": {
    "CLOUDFLARE_WORKER": "1",
    "OBJECT_STORAGE_DRIVER": "cloudinary",
    "LOG_LEVEL": "info"
  },
  "alias": {
    "@google-cloud/storage": "./src/lib/cloudflare/gcsSdkStub.ts"
  }
}
