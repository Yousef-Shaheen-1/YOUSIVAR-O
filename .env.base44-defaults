# Committed placeholders for the Base44 sandbox. Real credentials are injected
# by the platform from /run/base44/app.env, which is listed AFTER this file in
# docker-compose.base44.yml, so anything set there always wins.
#
# Never put a real secret in this file.

# Replit Object Storage is not reachable from the sandbox (it signs upload URLs
# through a Replit-local sidecar), so media uploads cannot work here. These
# placeholders only keep the storage routes from failing on missing config.
DEFAULT_OBJECT_STORAGE_BUCKET_ID=base44-local-placeholder
PRIVATE_OBJECT_DIR=/base44-local-placeholder/private
PUBLIC_OBJECT_SEARCH_PATHS=/base44-local-placeholder/public
