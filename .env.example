# Replit manages DATABASE_URL, Clerk credentials, and object-storage variables.
# Configure those through your production platform secret store; do not put real
# credentials in this file.
DATABASE_URL=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=/api/__clerk
API_PROXY_ORIGIN=
OWNER_EMAIL=

# Owner access (the Ω flow). The registered owner account is compared
# server-side against these values; never commit real credentials. Use
# OWNER_PASSWORD_HASH (scrypt) instead of OWNER_PASSWORD when you would rather
# not keep the plain password in secret storage.
OWNER_USERNAME=
OWNER_PASSWORD=
OWNER_PASSWORD_HASH=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Optional owner access tuning (defaults shown).
OWNER_OTP_TTL_SECONDS=600
OWNER_OTP_MAX_ATTEMPTS=5
OWNER_OTP_RESEND_COOLDOWN_SECONDS=45
OWNER_OTP_MAX_SENDS=5
OWNER_CHALLENGE_TTL_SECONDS=900
OWNER_SESSION_SECONDS=43200

OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_API_KEY=
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# Cloudflare Pages deployment settings
CF_PAGES=1
CLOUDFLARE_PAGES=1
