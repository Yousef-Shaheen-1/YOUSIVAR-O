# Node wrapper (package-lock.json IS committed: CI installs with `npm ci`)
node_modules/

# Build output published by scripts/build-android.mjs
dist/

# Android build output
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/captures/
android/app/release/
android/app/debug/

# Capacitor copies www/ into the native project on every sync; it is generated.
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# Signing material must never be committed.
*.keystore
*.jks
android/key.properties
