<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme: obsidian chrome, no action bar, light system
         bar icons because every surface behind them is dark. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/omega_obsidian</item>
        <item name="android:statusBarColor">@color/omegaStatusBar</item>
        <item name="android:navigationBarColor">@color/omegaNavigationBar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/omega_obsidian</item>
        <item name="android:statusBarColor">@color/omegaStatusBar</item>
        <item name="android:navigationBarColor">@color/omegaNavigationBar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Launch screen: the same obsidian surface with the Ω mark, then the
         splash is dismissed by Capacitor once the WebView has loaded. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor">@color/omegaStatusBar</item>
        <item name="android:navigationBarColor">@color/omegaNavigationBar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
